{"id":"87e5b190-d370-40e8-bd1e-aa329b58ac0c","revision":0,"last_node_id":29,"last_link_id":30,"nodes":[{"id":2,"type":"LoadImage","pos":[-760,-10],"size":[330,460],"flags":{},"order":0,"mode":0,"inputs":[],"outputs":[{"name":"IMAGE","type":"IMAGE","links":[6,13,18]},{"name":"MASK","type":"MASK","links":null}],"properties":{"cnr_id":"comfy-core","ver":"0.41.0","Node name for S&R":"LoadImage","ue_properties":{"widget_ue_connectable":{},"input_ue_unconnectable":{},"version":"7.8"}},"widgets_values":["Qwen 2.1_2026-09-29_00005.png","image"],"widgets_values_named":{"image":"Qwen 2.1_2026-09-29_00005.png","upload":"image"},"color":"#233","bgcolor":"#355"},{"id":5,"type":"LCSaveImage","pos":[1260,-10],"size":[300,470],"flags":{},"order":15,"mode":0,"inputs":[{"name":"images","type":"IMAGE","link":16},{"name":"metadata","shape":7,"type":"LC_SAVE_META","link":null},{"name":"filename","type":"STRING","widget":{"name":"filename"},"link":29}],"outputs":[{"name":"images","type":"IMAGE","links":null},{"name":"saved_as","type":"STRING","links":null}],"properties":{"cnr_id":"ComfyUI_LC123_nodes","ver":"ca1022f3e793a5d79e345fa099d389df4156a948","Node name for S&R":"LCSaveImage","ue_properties":{"widget_ue_connectable":{},"input_ue_unconnectable":{},"version":"7.8"}},"widgets_values":["Skin Master","","png",95,true,true,true,""],"widgets_values_named":{"filename":"Skin Master","path":"","format":"png","quality":95,"embed_workflow":true,"embed_civitai":true,"hash_resources":true,"filename_prefix":""},"color":"#28281E","bgcolor":"#28281E"},{"id":9,"type":"LCSkinMaster","pos":[200,30],"size":[700,540],"flags":{},"order":13,"mode":0,"inputs":[{"name":"image","type":"IMAGE","link":6},{"name":"mask","shape":7,"type":"MASK","link":25},{"name":"seed","type":"INT","widget":{"name":"seed"},"link":12}],"outputs":[{"name":"image","type":"IMAGE","links":[14,16]},{"name":"skin_mask","type":"MASK","links":[]}],"properties":{"cnr_id":"ComfyUI_LC123_nodes","ver":"77a1705b093dcba108e00b7c914c7ef42a3e9