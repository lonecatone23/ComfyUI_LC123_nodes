0","outlineWidth":4,"shadow":false,"shadowBlur":10,"bg":false,"bgColor":"#324B4B","radius":12,"padding":8,"angle":0,"width":0,"cnr_id":"ComfyUI_LC123_nodes","ver":"9e2b116f51ee00939bd292cf6b5441a10923dd02","Node name for S&R":"LCLabel","_w":268,"_h":128,"ue_properties":{"widget_ue_connectable":{},"input_ue_unconnectable":{},"version":"7.8"}},"color":"#fff0","bgcolor":"#fff0"},{"id":18,"type":"LCImageSplit","pos":[950,530],"size":[300,450],"flags":{},"order":14,"mode":0,"inputs":[{"name":"image_a","type":"IMAGE","link":13},{"name":"image_b","type":"IMAGE","link":14}],"outputs":[{"name":"split 🖼️","type":"IMAGE","links":[15]}],"properties":{"cnr_id":"ComfyUI_LC123_nodes","ver":"9e2b116f51ee00939bd292cf6b5441a10923dd02","Node name for S&R":"LCImageSplit","ue_properties":{"widget_ue_connectable":{},"input_ue_unconnectable":{},"version":"7.8"}},"widgets_values":[0.49,true,10,"#FFFFFF"],"widgets_values_named":{"split_position":0.49,"show_divider":true,"divider_width":10,"divider_color":"#FFFFFF"},"color":"#324B4B","bgcolor":"#324B4B"},{"id":19,"type":"LCTextOverlay","pos":[1260,530],"size":[300,640],"flags":{},"order":16,"mode":0,"inputs":[{"name":"image","type":"IMAGE","link":15}],"outputs":[{"name":"image","type":"IMAGE","links":[17]}],"properties":{"cnr_id":"ComfyUI_LC123_nodes","ver":"9e2b116f51ee00939bd292cf6b5441a10923dd02","Node name for S&R":"LCTextOverlay","ue_properties":{"widget_ue_connectable":{},"input_ue_unconnectable":{},"version":"7.8"},"lc_overlay_text":"Before                         After","lc_preview_meta":[{"filename":"lc_before_temp_pjpkl_00012_.png","subfolder":"","type":"temp","metadata":{"kind":"image","width":3648,"height":4512},"id":"da49048b-dea7-4182-bb76-bea84440da10"}]},"widgets_values":["Before                         After","Arial",173,255,255,255,47.4,93.1,"center"],"widgets_values_named":{"text":"Before                         After","font":"Arial","font_size":173,"color_r":255,"color_g":255,"color_b":255,"x_percent":47.4,"y_percent":93.1,"alignment":"center"},"color":"#324B4B","bgcolor":"#324B4B"},{"id":21,"type":"SaveImage","pos":[1570,530],"size":[350,450],"flags":{},"order":17,"mode":0,"inputs":[{"name":"images","type":"IMAGE","link":17},{"name":"filename_prefix","type":"STRING","widget":{"name":"filename_prefix"},"link":30}],"outputs":[{"name":"images","type":"IMAGE","links":null}],"properties":{"cnr_id":"comfy-core","ver":"0.42.0","ue_properties":{"widget_ue_connectable":{},"input_ue_unconnectable":{},"version":"7.8"}},"widgets_values":["Test"],"widgets_values_named":{"filename_prefix":"Test"},"color":"#233","bgcolor":"#355"},{"id":22,"type":"LCPersonMask","pos":[-390,130],"size":[300,490],"flags":{},"order":10,"mode":0,"inputs":[{"name":"image","type":"IMAGE","link":18}],"outputs":[{"name":"cutout","type":"IMAGE","links":[21]},{"name":"mask","type":"MASK","links":[23]},{"name":"raw_mask","type":"MASK","links":[]}],"properties":{"cnr_id":"ComfyUI_LC_MaskMaker_nodes","ver":"c4589c19a9cda0fea4f71f0d8b0e19d12a831536","Node name for S&R":"LCPersonMask","ue_properties":{"widget_ue_connectable":{},"input_ue_unconnectable":{},"version":"7.8"}},"widgets_values":["segformer","models/segformer_b2_clothes (local)",true,false,true,false,false,false,0.4,"vitmatte","models/vitmatte (local)",10,10,0.01,0.99,2,false],"widgets_values_named":{"engine":"segformer","segformer_model":"models/segformer_b2_clothes (local)","face":true,"hair":false,"body":true,"clothes":false,"accessories":false,"background":false,"confidence":0.4,"refine":"vitmatte","vitmatte_model":"models/vitmatte (local)","edge_erode":10,"edge_dilate":10,"black_point":0.01,"white_point":0.99,"max_megapixels":2,"remove_features":false},"color":"#324b4b","bgcolor":"#324b4b"},{"id":24,"type":"LC Bypasser","pos":[-80,570],"size":[280,250],"flags":{"collapsed":true},"order":12,"mode":0,"inputs":[{"name":"LC Person Mask 🧍","type":"*","link":21},{"name":"enable","type":"BOOLEAN","link":26},{"name":"LC Preview Mask 🎭","type":"*","link":24},{"name":"enable","type":"BOOLEAN","link":28},{"name":"","type":"*","link":null},{"name":"enable","type":"BOOLEAN","link":null}],"outputs":[{"name":"OPT_CONNECTION","type":"*","links":null}],"properties":{"toggleRestriction":"default","ue_properties":{"widget_ue_connectable":{},"version":"7.8","input_ue_unconnectable":{}}},"widgets_values":[true,true],"widgets_values_named":{"Enable 1":true,"Enable 2":true},"color":"#28281E","bgcolor":"#28281E"},{"id":25,"type":"LCPreviewMask","pos":[-80,130],"size":[220,320],"flags":{},"order":11,"mode":0,"inputs":[{"name":"mask","shape":7,"type":"MASK","link":23}],"outputs":[{"name":"mask","type":"MASK","links":[24,25]}],"properties":{"cnr_id":"ComfyUI_LC123_nodes","ver":"9e2b116f51ee00939bd292cf6b5441a10923dd02","Node name for S&R":"LCPreviewMask","ue_properties":{"widget_ue_connectable":{},"input_ue_unconnectable":{},"version":"7.8"}},"widgets_values":[""],"widgets_values_named":{"lc_preview":""},"color":"#222","bgcolor":"#000"},{"id":26,"type":"PrimitiveBoolean","pos":[-390,30],"size":[300,60],"flags":{"collapsed":false},"order":6,"mode":0,"inputs":[{"label":"person_mask","name":"value","type":"BOOLEAN","widget":{"name":"value"},"link":null}],"outputs":[{"name":"BOOLEAN","type":"BOOLEAN","links":[26,28]}],"title":"Use Person Mask","properties":{"cnr_id":"comfy-core","ver":"0.42.0","Node name for S&R":"PrimitiveBoolean","ue_properties":{"widget_ue_connectable":{},"input_ue_unconnectable":{},"version":"7.8"}},"widgets_values":[true],"widgets_values_named":{"value":true},"color":"#c87a2c","bgcolor":"#b46618"},{"id":27,"type":"LCNote","pos":[200,630],"size":[710,520],"flags":{},"order":7,"mode":0,"inputs":[],"outputs":[],"properties":{"lc_note":{"source":"en","texts":{"en":{"text":"## LC Skin Master ✨\n---\n\n**What is it?**\n- Your whole skin chain in one node: grit, pores, blemishes, lines, freckles, eyes, skin tone and colour. Each one done once, in order, on one skin map.\n\n- 💡Plug the **skin_mask** into **LC Sharpen Pro**, so skin_protect covers all the skin instead of the part a colour guess finds.\n- ✋ **First run downloads about 80 MB** (face finders) into `models/facexlib`.\n\n**Settings ⚙️**\n\n**Presets**: \n- **Natural** for every day. \n- **Soft Beauty** for images with makeup.\n- **Editorial Detail** for close-ups (sharp 🗡️)\n- **Real Skin Restore** for plastic skin\n- **Weathered** for character (my favorite in most cases)\n- **Sun-Kissed** for freckles. \n- *Moving a slider switches to Custom.*\n\n**Sliders:**\n\n- **pores**: 1 = as it is. Keep it at 1 or more with **pigmentation**, or the freckles look painted on.\n- **add_pores**: for skin that has none. Skin with detail gets less on its own.\n- **wrinkles**: below 0 softens, above 0 deepens the lines already there.\n- **warmth**: below 0 calms orange AI skin.\n- **eye_detail**: crisper lashes and a lifted iris around a dark pupil, so the eyes look alive. 0.5 default, 1.0 is the top.\n\n**Mask 🎭 **\n\n**It's optional.** If all you care about is faces, then you do not need it. The node will find them by itself. It will also grab skin about 50% of the time. However, if you want **all** skin that misses clothes, then use my person mask. \n\n---\n**Credits:**\n\nSkin finding and the retouch adapted from sd-living-skin by sca-285 (MIT) [Here](https://github.com/sca-285/sd-living-skin)\n\n"},"zh":{"text":"## LC Skin Master ✨\n---\n\n**这是什么？**\n- 整条皮肤处理链集于一个节点：颗粒感、毛孔、瑕疵、纹路、雀斑、眼睛、肤色和色彩。每一项按顺序、在同一张皮肤图上只处理一次。\n\n- 💡把 **skin_mask** 接入 **LC Sharpen Pro**，这样 skin_protect 就能覆盖所有皮肤，而不是只覆盖靠颜色猜出来的那一部分。\n- ✋ **首次运行会下载约 80 MB**（人脸检测器）到 `models/facexlib`。\n\n**设置 ⚙️**\n\n**预设**： \n- **Natural**：日常使用。 \n- **Soft Beauty**：带妆的图像。\n- **Editorial Detail**：特写（锐利 🗡️）\n- **Real Skin Restore**：塑料感皮肤\n- **Weathered**：有性格的角色（多数情况下我的最爱）\n- **Sun-Kissed**：雀斑。 \n- *一动滑块就会切换到 Custom。*\n\n**滑块：**\n\n- **pores**: 1 = 保持原样。搭配 **pigmentation** 时请保持在 1 或更高，否则雀斑看起来像画上去的。\n- **add_pores**: 给本来没有毛孔的皮肤用。本身有细节的皮肤会自动少加一些。\n- **wrinkles**: 小于 0 会柔化，大于 0 会加深已有的纹路。\n- **warmth**: 小于 0 可以压住 AI 皮肤的橙色调。\n- **eye_detail**: 睫毛更清晰，深色瞳孔周围的虹膜被提亮，眼睛更有神。默认 0.5，最高 1.0。\n\n**蒙版 🎭 **\n\n**它是可选的。** 如果你只在意脸，就不需要它。节点会自己找到人脸。它大约有 50% 的概率也会抓到皮肤。不过，如果你想要**所有**避开衣服的皮肤，就用我的 person mask。 \n\n---\n**致谢：**\n\n皮肤检测和修饰改编自 sca-285 的 sd-living-skin (MIT) [这里](https://github.com/sca-285/sd-living-skin)\n\n","src":"d3475e83","srcTitle":""},"ja":{"text":"## LC Skin Master ✨\n---\n\n**これは何？**\n- 肌のチェーン全体を1つのノードに：ざらつき、毛穴、シミ、シワ、そばかす、目、肌のトーンと色。それぞれが、1枚の肌マップに対して順番に一度ずつ処理されます。\n\n- 💡**skin_mask** を **LC Sharpen Pro** につなぐと、skin_protectが、色の推測で見つかった部分ではなく、肌全体をカバーします。\n- ✋ **初回実行時に約80 MBがダウンロードされます**（顔検出）。`models/facexlib` に入ります。\n\n**設定 ⚙️**\n\n**プリセット**： \n- 毎日使うなら **Natural**。 \n- メイクした画像には **Soft Beauty**。\n- クローズアップには **Editorial Detail**（シャープ 🗡️）\n- プラスチックのような肌には **Real Skin Restore**\n- キャラクターもの向けの **Weathered**（たいていのケースで私のお気に入り）\n- そばかす向けの **Sun-Kissed**。 \n- *スライダーを動かすとCustomに切り替わります。*\n\n**スライダー：**\n\n- **pores**: 1＝そのまま。**pigmentation** と一緒に使うときは1以上にしておかないと、そばかすが描き足したように見えます。\n- **add_pores**: 毛穴のない肌向け。ディテールのある肌には、自動的に少なくかかります。\n- **wrinkles**: 0未満は和らげ、0より上は元からあるシワを深くします。\n- **warmth**: 0未満は、オレンジがかったAIの肌を落ち着かせます。\n- **eye_detail**: まつ毛をくっきりさせ、暗い瞳孔のまわりの虹彩を明るくして、目に生気を出します。デフォルトは0.5、1.0が上限です。\n\n**マスク 🎭 **\n\n**任意です。** 顔さえあればいいなら、必要ありません。ノードが自分で顔を見つけます。肌も50%くらいは自動で拾います。ただし、服を避けた**すべての**肌がほしいなら、私のperson maskを使ってください。 \n\n---\n**クレジット：**\n\n肌の検出とレタッチは、sca-285さんのsd-living-skin（MIT）を元に改変しています [こちら](https://github.com/sca-285/sd-living-skin)\n\n","src":"d3475e83","srcTitle":""},"ko":{"text":"## LC Skin Master ✨\n---\n\n**이게 뭔가요?**\n- 피부 체인 전체를 노드 하나에: grit, 모공, 잡티, 주름, 주근깨, 눈, 피부톤, 색. 각각을 하나의 skin map 위에서 순서대로 한 번씩 처리합니다.\n\n- 💡**skin_mask**를 **LC Sharpen Pro**에 연결하면 skin_protect가 색 추정으로 찾은 일부가 아니라 피부 전체를 덮습니다.\n- ✋ **첫 실행 때 약 80 MB**(얼굴 탐지기)를 `models/facexlib`에 다운로드합니다.\n\n**설정 ⚙️**\n\n**프리셋**: \n- **Natural** 일상용. \n- **Soft Beauty** 메이크업한 이미지용.\n- **Editorial Detail** 클로즈업용 (샤프 🗡️)\n- **Real Skin Restore** 플라스틱 같은 피부용\n- **Weathered** 캐릭터용 (대부분 제가 가장 좋아하는 프리셋)\n- **Sun-Kissed** 주근깨용. \n- *슬라이더를 움직이면 Custom으로 바뀝니다.*\n\n**슬라이더:**\n\n- **pores**: 1 = 그대로. **pigmentation**과 함께 쓸 땐 1 이상으로 두세요. 안 그러면 주근깨가 그려 넣은 것처럼 보입니다.\n- **add_pores**: 모공이 없는 피부용. 디테일이 있는 피부엔 알아서 덜 들어갑니다.\n- **wrinkles**: 0 미만은 부드럽게, 0 초과는 이미 있는 주름을 깊게 합니다.\n- **warmth**: 0 미만은 AI 특유의 주황빛 피부를 가라앉힙니다.\n- **eye_detail**: 속눈썹을 또렷하게 하고 어두운 동공 주변의 홍채를 밝혀 눈에 생기를 줍니다. 기본값 0.5, 최대 1.0.\n\n**마스크 🎭 **\n\n**선택 사항입니다.** 얼굴만 신경 쓰면 필요 없습니다. 노드가 알아서 얼굴을 찾고, 피부도 50% 정도는 잡아냅니다. 하지만 옷에 가려지지 않은 **모든** 피부를 원하면 제 person mask를 쓰세요. \n\n---\n**크레딧:**\n\n피부 탐지와 리터치는 sca-285의 sd-living-skin(MIT)을 응용했습니다 [여기](https://github.com/sca-285/sd-living-skin)\n","src":"d3475e83","srcTitle":""}},"titles":{}},"ue_properties":{"widget_ue_connectable":{},"version":"7.8","input_ue_unconnectable":{}}},"widgets_values":["English ✏️","## LC Skin Master ✨\n---\n\n**What is it?**\n- Your whole skin chain in one node: grit, pores, blemishes, lines, freckles, eyes, skin tone and colour. Each one done once, in order, on one skin map.\n\n- 💡Plug the **skin_mask** into **LC Sharpen Pro**, so skin_protect covers all the skin instead of the part a colour guess finds.\n- ✋ **First run downloads about 80 MB** (face finders) into `models/facexlib`.\n\n**Settings ⚙️**\n\n**Presets**: \n- **Natural** for every day. \n- **Soft Beauty** for images with makeup.\n- **Editorial Detail** for close-ups (sharp 🗡️)\n- **Real Skin Restore** for plastic skin\n- **Weathered** for character (my favorite in most cases)\n- **Sun-Kissed** for freckles. \n- *Moving a slider switches to Custom.*\n\n**Sliders:**\n\n- **pores**: 1 = as it is. Keep it at 1 or more with **pigmentation**, or the freckles look painted on.\n- **add_pores**: for skin that has none. Skin with detail gets less on its own.\n- **wrinkles**: below 0 softens, above 0 deepens the lines already there.\n- **warmth**: below 0 calms orange AI skin.\n- **eye_detail**: crisper lashes and a lifted iris around a dark pupil, so the eyes look alive. 0.5 default, 1.0 is the top.\n\n**Mask 🎭 **\n\n**It's optional.** If all you care about is faces, then you do not need it. The node will find them by itself. It will also grab skin about 50% of the time. However, if you want **all** skin that misses clothes, then use my person mask. \n\n---\n**Credits:**\n\nSkin finding and the retouch adapted from sd-living-skin by sca-285 (MIT) [Here](https://github.com/sca-285/sd-living-skin)\n\n"],"widgets_values_named":{"language":"English ✏️","text":"## LC Skin Master ✨\n---\n\n**What is it?**\n- Your whole skin chain in one node: grit, pores, blemishes, lines, freckles, eyes, skin tone and colour. Each one done once, in order, on one skin map.\n\n- 💡Plug the **skin_mask** into **LC Sharpen Pro**, so skin_protect covers all the skin instead of the part a colour guess finds.\n- ✋ **First run downloads about 80 MB** (face finders) into `models/facexlib`.\n\n**Settings ⚙️**\n\n**Presets**: \n- **Natural** for every day. \n- **Soft Beauty** for images with makeup.\n- **Editorial Detail** for close-ups (sharp 🗡️)\n- **Real Skin Restore** for plastic skin\n- **Weathered** for character (my favorite in most cases)\n- **Sun-Kissed** for freckles. \n- *Moving a slider switches to Custom.*\n\n**Sliders:**\n\n- **pores**: 1 = as it is. Keep it at 1 or more with **pigmentation**, or the freckles look painted on.\n- **add_pores**: for skin that has none. Skin with detail gets less on its own.\n- **wrinkles**: below 0 softens, above 0 deepens the lines already there.\n- **warmth**: below 0 calms orange AI skin.\n- **eye_detail**: crisper lashes and a lifted iris around a dark pupil, so the eyes look alive. 0.5 default, 1.0 is the top.\n\n**Mask 🎭 **\n\n**It's optional.** If all you care about is faces, then you do not need it. The node will find them by itself. It will also grab skin about 50% of the time. However, if you want **all** skin that misses clothes, then use my person mask. \n\n---\n**Credits:**\n\nSkin finding and the retouch adapted from sd-living-skin by sca-285 (MIT) [Here](https://github.com/sca-285/sd-living-skin)\n\n"},"color":"#222","bgcolor":"#000"},{"id":28,"type":"LCEasyFolder","pos":[950,-10],"size":[300,160],"flags":{},"order":8,"mode":0,"inputs":[],"outputs":[{"name":"filename_prefix","type":"STRING","links":[29,30]}],"properties":{"cnr_id":"ComfyUI_LC123_nodes","ver":"9e2b116f51ee00939bd292cf6b5441a10923dd02","Node name for S&R":"LCEasyFolder","ue_properties":{"widget_ue_connectable":{},"input_ue_unconnectable":{},"version":"7.8"}},"widgets_values":["Skin Master","Test","","%Y-%m-%d","auto"],"widgets_values_named":{"folder":"Skin Master","prefix":"Test","suffix":"","timestamp":"%Y-%m-%d","path_separator":"auto"},"color":"#324B4B","bgcolor":"#324B4B"},{"id":29,"type":"LCNote","pos":[-1190,-10],"size":[400,530],"flags":{},"order":9,"mode":0,"inputs":[],"outputs":[],"properties":{"lc_note":{"source":"en","texts":{"en":{"text":"@[card: Follow me](https://civitai.com/user/lonecatone23)\n\n@[card: Follow me](https://www.instagram.com/synth.studio.models/)\n\n@[card: Get my stuff here](https://github.com/lonecatone23)\n\n@[card: Get my models here](https://huggingface.co/Lonecatone23)\n\n\n@[card: Buy me a ☕](https://ko-fi.com/lonecatone)\n\n### This is many hours of work. If you enjoy it, please 👍 like, 💬 comment, and feel free to ⚡ tip 😉\n"},"zh":{"text":"@[card: 关注我](https://civitai.com/user/lonecatone23)\n\n@[card: 关注我](https://www.instagram.com/synth.studio.models/)\n\n@[card: 获取我的作品](https://github.com/lonecatone23)\n\n@[card: 获取我的模型](https://huggingface.co/Lonecatone23)\n\n\n@[card: 请我喝杯 ☕](https://ko-fi.com/lonecatone)\n\n### 这是很多个小时的心血。如果你喜欢，请 👍 点赞、💬 评论，也欢迎 ⚡ 打赏 😉\n\n","src":"d8eb9351","srcTitle":""},"ja":{"text":"@[card: フォローしてね](https://civitai.com/user/lonecatone23)\n\n@[card: フォローしてね](https://www.instagram.com/synth.studio.models/)\n\n@[card: 私の作品はこちら](https://github.com/lonecatone23)\n\n@[card: 私のモデルはこちら](https://huggingface.co/Lonecatone23)\n\n\n@[card: ☕をおごってね](https://ko-fi.com/lonecatone)\n\n### 何時間もかけて作っ