"widget_ue_connectable":{},"input_ue_unconnectable":{},"version":"7.8"}},"widgets_values":[],"color":"#325A5A","bgcolor":"#325A5A"},{"id":19,"type":"PlaySound|pysssss","pos":[-8200,-1940],"size":[270,110],"flags":{"collapsed":true},"order":12,"mode":0,"inputs":[{"localized_name":"any","name":"any","type":"*","link":35},{"localized_name":"mode","name":"mode","type":"COMBO","widget":{"name":"mode"},"link":null},{"localized_name":"volume","name":"volume","type":"FLOAT","widget":{"name":"volume"},"link":null},{"localized_name":"file","name":"file","type":"STRING","widget":{"name":"file"},"link":null}],"outputs":[{"localized_name":"*","name":"*","shape":6,"type":"*","links":[95]}],"title":"PlaySound 🔊","properties":{"cnr_id":"comfyui-custom-scripts","ver":"609f3afaa74b2f88ef9ce8d939626065e3247469","Node name for S&R":"PlaySound|pysssss","ue_properties":{"widget_ue_connectable":{},"input_ue_unconnectable":{},"version":"7.8"}},"widgets_values":["always",1,"notify.mp3"],"color":"#2a363b","bgcolor":"#3f5159"},{"id":8,"type":"Fast Bypasser (rgthree)","pos":[-7280,-2100],"size":[470,560],"flags":{},"order":33,"mode":0,"inputs":[{"dir":3,"name":"LC Image Denoise","type":"*","link":8},{"dir":3,"name":"","type":"*","link":null}],"outputs":[{"dir":4,"name":"OPT_CONNECTION","type":"*","links":null}],"properties":{"toggleRestriction":"default","ue_properties":{"widget_ue_connectable":{},"input_ue_unconnectable":{},"version":"7.8"}},"color":"#c3782d","bgcolor":"#af6419"},{"id":42,"type":"LCGetImage","pos":[-6800,-2100],"size":[300,120],"flags":{},"order":32,"mode":0,"inputs":[{"localized_name":"image","name":"image","type":"IMAGE","link":99}],"outputs":[{"localized_name":"megapixels","name":"megapixels","type":"FLOAT","links":null},{"localized_name":"width","name":"width","type":"INT","links":null},{"localized_name":"height","name":"height","type":"INT","links":null},{"localized_name":"batch","name":"batch","type":"INT","links":null},{"localized_name":"aspect ratio","name":"aspect ratio","type":"STRING","links":null}],"properties":{"Node name for S&R":"LCGetImage","ue_properties":{"widget_ue_connectable":{},"input_ue_unconnectable":{},"version":"7.8"}},"widgets_values":[],"color":"#324b4b","bgcolor":"#324b4b"},{"id":5,"type":"GetNode","pos":[-8660,-3320],"size":[210,60],"flags":{"collapsed":true},"order":3,"mode":0,"inputs":[],"outputs":[{"name":"IMAGE","type":"IMAGE","links":[6,38,98]}],"title":"Get_Image 1","properties":{"Node name for S&R":"GetNode","aux_id":"kijai/ComfyUI-KJNodes","ue_properties":{"widget_ue_connectable":{},"version":"7.8","input_ue_unconnectable":{}}},"widgets_values":["Image 1"],"color":"#2a363b","bgcolor":"#3f5159"},{"id":44,"type":"MarkdownNote","pos":[-6470,-3360],"size":[770,1900],"flags":{},"order":4,"mode":0,"inputs":[],"outputs":[],"title":"Notes:","properties":{"ue_properties":{"widget_ue_connectable":{},"version":"7.8","input_ue_unconnectable":{}}},"widgets_values":["\n## Instructions\n\n# 🛑🚫✋ I HIGHLY suggest that you fix the seed, run the pic, then don’t mess with anything before this so it doesn’t reprocess.\n\n### Node order (follow the chain top → bottom)\n\n**Smart Denoise (LCImageDenoise)**  \n- Removes noise while trying to keep detail  \n- Sigma: higher = smoother, lower = more detail  \n- Threshold: how aggressive the denoise is  \n- Radius Multiplier: higher for noisy images, lower for clean ones  \n💡 Start gentle. Only raise values if the image is actually noisy.\n\n**Color Match (LCColorMatch)**  \n- Matches colors to a reference image (usually Image 2)  \n- Method: “adain” is the most common and stable  \n- Strength: 0–1  \n\n**Bloom (LCBloom)**  \n- Soft glow on bright areas (camera light bloom)  \n- Intensity, threshold, and size controls  \n💡 A little makes it dreamy. A lot makes it foggy.\n\n**Vignette (LCVignette)**  \n- Darkens (or lightens) the edges  \n- Amount, softness, and roundness  \n💡 Soft vignette looks more natural than hard black borders.\n\n**Image RGB (LCImageRGB)**  \n- Simple red / green / blue channel gain  \n\n**Lift / Gamma / Gain (LCLiftGammaGain)**  \n- Classic three-way color corrector  \n- Lift = shadows  \n- Gamma = midtones  \n- Gain = highlights  \n💡 This is where most “film look” color work happens.\n\n**Auto White Balance (LCAutoWhiteBalance)**  \n- Tries to neutralize overall color cast  \n- Method: “Shades of Gray” is usually safest  \n💡 Effect is subtle — compare before/after.\n\n**Vibrance (LCVibrance)**  \n- Boosts muted colors without destroying already-saturated areas  \n- Kinder to skin than normal saturation  \n- Vibrance + Saturation + Strength  \n💡 Prefer this over regular saturation for portraits.\n\n**Chromatic Aberration (LCChromaticAberration)**  \n- Shifts RGB channels for a 3-D / vintage lens look  \n- Separate horizontal/vertical amounts for R, G, B  \n💡 A little goes a long way. Try small opposite values (R +2, G –1, B –3).\n\n**Clarity (LCClarity)**  \n- Adaptive mid-tone contrast / micro-contrast  \n- Radius, strength, blend mode, shadow/highlight controls  \n💡 Super important node. Adds “pop” without the cardboard cut-out look.\n\n**Image Adjust (LCImageAdjust)**  \n- Brightness, Contrast, Saturation, Sharpness, Blur  \n- Brightness center = 0  \n- Contrast & Saturation center = 1  \n\n**Lens FX (LCLensFX)**  \n- General lens distortion and optical effects  \n💡 Pair with the next node for more realistic camera simulation.\n\n**Lens Profile (LCLensProfile)**  \n- Applies real lens characteristics (e.g. Canon 50mm f/1.8)  \n- Optional aberrations  \n💡 Adds subtle optical imperfections that make AI images feel more photographic.\n\n**Film Stock B&W (LCFilmStockBW)**  \n- Converts to black & white using real film responses  \n- 50+ stocks (Ilford HP5+, Kodak Tri-X, Fuji Acros, etc.)  \n- Strength + optional filter  \n💡 Leave this off if you want to keep color.\n\n**Film Stock Color (LCFilmStockColor)**  \n- Applies classic color film response (Ektachrome, Portra, etc.)  \n- Strength is the main control  \n💡 0.6–0.9 often looks more natural than full strength.\n\n**Film Grain (LCFilmGrain)**  \n- Realistic film grain with lots of control  \n- Power, scale, shadows/highlights, seed  \n💡 Fixed seed keeps the grain consistent. Slightly more grain in shadows usually looks better.\n\n**Desaturate (LCImageDesaturate)**  \n- Partial or full desaturation  \n- Several methods (luminance Rec.709 is common)  \n💡 Useful right before a LUT if you want a muted base.\n\n**Apply LUT (LCApplyLUT)**  \n- Applies a 3D LUT (.cube file)  \n- Strength 0–1  \n- Log option for certain LUTs  \n💡 Free LUTs at freshluts.com. Strength 0.3–0.7 is often nicer than 1.0. Put .cube files in the luts folder.\n\n**Image Crop (LCImageCrop)**  \n- Inline crop tool  \n- X / Y / Width / Height or free mode  \n💡 Crop after all effects so you don’t lose edge treatments (vignette, bloom, etc.).\n\n**Text Overlay (LCTextOverlay)**  \n- Adds text on the final image  \n- Font, size, color, position, opacity  \n💡 Great for watermarks or quick titles.\n\n---\n\n## 使用说明\n\n# 🛑🚫✋ 强烈建议你先固定 seed，跑完图片，然后不要再动之前的任何设置，以免重新处理。\n\n### 节点顺序（按链条从上到下）\n\n**智能降噪 (LCImageDenoise)**  \n- 在尽量保留细节的同时去除噪点  \n- Sigma：数值高更平滑，低则保留更多细节  \n- Threshold：控制降噪强度  \n- Radius Multiplier：噪点多的图用高值，干净的图用低值  \n💡 从低数值开始。只有真正很噪的时候才提高。\n\n**颜色匹配 (LCColorMatch)**  \n- 让当前图匹配参考图（通常是 Image 2）的色调  \n- 方法：adain 最常用也最稳定  \n- 强度：0–1  \n💡 做系列图统一肤色或情绪时很好用。不需要时把参考关掉。\n\n**光晕 (LCBloom)**  \n- 给高光加柔和辉光，模拟相机过曝  \n- 强度、阈值、大小  \n💡 少用一点很梦幻，多用就变雾了。\n\n**暗角 (LCVignette)**  \n- 压暗（或提亮）边缘  \n- 强度、柔和度、圆度  \n💡 柔和暗角比硬黑边自然得多。\n\n**RGB 调整 (LCImageRGB)**  \n- 简单的红 / 绿 / 蓝通道增益  \n\n\n**Lift / Gamma / Gain (LCLiftGammaGain)**  \n- 经典三点校色  \n- Lift = 阴影  \n- Gamma = 中间调  \n- Gain = 高光  \n💡 大部分“胶片感”颜色工作都在这里完成。\n\n**自动白平衡 (LCAutoWhiteBalance)**  \n- 尝试中和整体色偏  \n- 方法：“Shades of Gray” 通常最稳妥  \n💡 效果比较细微，记得对比前后。\n\n**自然饱和度 (LCVibrance)**  \n- 提升不饱和颜色，对已经很艳的颜色和肤色更友好  \n- 自然饱和度 + 饱和度 + 强度  \n💡 人像优先用这个，而不是普通饱和度。\n\n**色差 (LCChromaticAberration)**  \n- 错开 RGB 通道，做出 3D / 复古镜头感  \n- 可分别调整红、绿、蓝的水平和垂直偏移  \n💡 一点就够。可以试小相反数值（R +2，G –1，B –3）。\n\n**清晰度 (LCClarity)**  \n- 自适应中间调对比度 / 微对比  \n- 半径、强度、混合模式、阴影/高光控制  \n💡 超级重要的节点。用来增加“通透感”但避免纸板剪影效果。\n\n**图像调整 (LCImageAdjust)**  \n- 亮度、对比度、饱和度、锐度、模糊  \n- 亮度中心 = 0  \n- 对比度与饱和度中心 = 1  \n\n\n**镜头特效 (LCLensFX)**  \n- 通用镜头畸变和光学效果  \n💡 和下一个节点一起用，模拟更真实的相机光学。\n\n**镜头配置文件 (LCLensProfile)**  \n- 应用真实镜头特性（例如 Canon 50mm f/1.8）  \n- 可选色差  \n💡 给 AI 图加一点真实光学瑕疵，照片感会强很多。\n\n**黑白胶片 (LCFilmStockBW)**  \n- 用真实胶片光谱响应转黑白  \n- 50+ 种胶片（Ilford HP5+、Kodak Tri-X、Fuji Acros 等）  \n- 强度 + 可选滤镜  \n💡 想留彩色就关掉这个。\n\n**彩色胶片 (LCFilmStockColor)**  \n- 应用经典彩色胶片响应（Ektachrome、Portra 等）  \n- 强度是主要控制  \n💡 0.6–0.9 往往比满强度更自然。\n\n**胶片颗粒 (LCFilmGrain)**  \n- 可精细控制的真实胶片颗粒  \n- 强度、缩放、阴影/高光、种子  \n💡 固定种子可以让颗粒保持一致。阴影区域颗粒稍强通常更好看。\n\n**去饱和 (LCImageDesaturate)**  \n- 部分或完全去饱和  \n- 多种方法可选（luminance Rec.709 较常用）  \n💡 在套 LUT 之前用，可以做出更柔和的基础色。\n\n**应用 LUT (LCApplyLUT)**  \n- 套用 3D LUT（.cube 文件）  \n- 强度 0–1  \n- Log 选项（部分 LUT 需要）  \n💡 免费 LUT 可在 freshluts.com 获取。强度 0.3–0.7 通常比 1.0 好看。把 .cube 文件放进 luts 文件夹。\n\n**裁剪 (LCImageCrop)**  \n- 内联裁剪工具  \n- X / Y / 宽 / 高 或 free 模式  \n💡 所有效果做完再裁，才不会丢掉边缘处理（暗角、光晕等）。\n\n**文字叠加 (LCTextOverlay)**  \n- 在最终图上加文字  \n- 字体、大小、颜色、位置、透明度  \n💡 适合加水印或简单标题。\n"],"color":"#222","bgcolor":"#000"},{"id":45,"type":"Label (rgthree)","pos":[-8990,-3640],"size":[1467.4072265625,150],"flags":{"allow_interaction":true},"order":5,"mode":0,"inputs":[],"outputs":[],"title":"Post Processing Suite","properties":{"fontSize":150,"fontFamily":"Arial","fontColor":"#ffffff","textAlign":"left","backgroundColor":"transparent","padding":0,"borderRadius":0,"angle":0,"ue_properties":{"widget_ue_connectable":{},"input_ue_unconnectable":{},"version":"7.8"}},"color":"#fff0","bgcolor":"#fff0"}],"links":[[1,2,0,1,0,"IMAGE"],[2,4,0,2,0,"IMAGE"],[3,1,0,3,0,"IMAGE"],[4,6,0,4,0,"IMAGE"],[5,9,0,4,1,"IMAGE"],[6,5,0,6,0,"IMAGE"],[7,3,0,7,0,"IMAGE"],[8,16,0,8,0,"*"],[9,11,0,10,0,"IMAGE"],[10,12,0,11,0,"IMAGE"],[11,7,0,12,0,"IMAGE"],[15,6,0,16,0,"IMAGE"],[16,4,0,16,1,"IMAGE"],[17,2,0,16,2,"IMAGE"],[18,1,0,16,3,"IMAGE"],[19,3,0,16,4,"IMAGE"],[20,7,0,16,5,"IMAGE"],[21,12,0,16,6,"IMAGE"],[22,11,0,16,7,"IMAGE"],[34,17,0,18,0,"IMAGE"],[35,21,0,19,0,"IMAGE"],[36,23,0,20,0,"IMAGE"],[38,5,0,21,1,"IMAGE"],[41,25,0,26,0,"IMAGE"],[42,27,0,28,0,"IMAGE"],[43,27,0,29,0,"IMAGE"],[44,18,0,30,0,"IMAGE"],[56,10,0,31,0,"IMAGE"],[59,10,0,16,8,"IMAGE"],[60,31,0,16,9,"IMAGE"],[63,30,0,35,0,"IMAGE"],[64,35,0,23,0,"IMAGE"],[73,31,0,38,0,"IMAGE"],[74,38,0,15,0,"IMAGE"],[75,38,0,16,10,"IMAGE"],[76,15,0,16,11,"IMAGE"],[83,15,0,39,0,"IMAGE"],[84,39,0,17,0,"IMAGE"],[85,39,0,16,12,"IMAGE"],[86,17,0,16,13,"IMAGE"],[87,18,0,16,14,"IMAGE"],[88,30,0,16,15,"IMAGE"],[89,35,0,16,16,"IMAGE"],[90,23,0,16,17,"IMAGE"],[93,20,0,16,18,"IMAGE"],[95,19,0,16,20,"*"],[96,20,0,40,0,"IMAGE"],[97,40,0,16,19,"IMAGE"],[98,5,0,21,0,"IMAGE"],[99,40,0,42,0,"IMAGE"]],"groups":[{"id":2,"title":"🎨 Post Processing Suite 260810","bounding":[-8980,-3430,3290,1980],"color":"#3f789e","flags":{}}],"config":{},"extra":{"ue_links":[],"k2cf_state_id":"k2cf_1785113348833_apxfftyz2ud","ds":{"scale":0.16105100000000103,"offset":[12089.632656788897,5192.148523518295]},"links_added_by_ue":[]},"version":0.4}